{
  "name": "neetcode-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_PATH=data/dev.db SEED_FILE=data/fixture.json next dev -p 3001 -H 127.0.0.1",
    "build": "next build",
    "start": "DATABASE_PATH=\"$HOME/Library/Application Support/NeetCode Tracker/data/neetcode-tracker.db\" next start -p 3000 -H 127.0.0.1",
    "start:sandbox": "DATABASE_PATH=data/sandbox.db next start -p 3002 -H 127.0.0.1",
    "sandbox:fill": "tsx scripts/fill-sandbox.ts",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "fetch:neetcode250": "tsx scripts/fetch-neetcode250.ts",
    "seed:dev": "DATABASE_PATH=data/dev.db tsx scripts/seed.ts data/fixture.json",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "app:package": "next build && tsx scripts/package-app.mts",
    "app:install": "scripts/install-app.sh --check-only && npm run app:package && scripts/install-app.sh",
    "app:sandbox": "scripts/open-app-sandbox.sh"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@next/env": "^16.4.6",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
