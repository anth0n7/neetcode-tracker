# No .env file is needed. The npm scripts set these themselves.
#
# DATABASE_PATH  Path to the SQLite file the app opens (required, no default).
#                npm start         -> ~/Library/Application Support/NeetCode Tracker/neetcode-tracker.db (real)
#                npm run dev       -> data/dev.db (5 fixture problems)
#                npm run start:sandbox -> data/sandbox.db (250 problems plus sample attempts, for manual checks)
# SEED_FILE      Problem list upserted at startup. Defaults to data/neetcode250.json.
#                npm run dev sets data/fixture.json.
